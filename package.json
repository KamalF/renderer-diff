    "markdown-it": "15.0.3",
    "mermaid": "12.2.0"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
