  "type": "module",
  "scripts": {
    "build": "esbuild src/plugin.ts --bundle --minify --format=iife --target=es2022 --external:node:* --outfile=dist/renderer-diff.js && cp node_modules/mermaid/dist/mermaid.min.js dist/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
